<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LSEBoardApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LSEBoard"
        tools:ignore="GoogleAppIndexingWarning">
        
        <!-- Setup Activity -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LSEBoard">
        </activity>

        <!-- Launcher Alias -->
        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="false"
            android:targetActivity=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LSEBoard">
        </activity>
        
        <!-- 設定頁面 - 2026 新增 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>
        
        <!-- 不設定 LAUNCHER，預設隱藏桌面圖示 -->

        <activity
            android:name=".CollectionActivity"
            android:exported="false"
            android:label="@string/title_collection"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <activity
            android:name=".AuthorParserActivity"
            android:exported="false"
            android:label="@string/author_parser_title"
            android:parentActivityName=".CollectionActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".CollectionActivity" />
        </activity>

        <activity
            android:name=".PackDetailActivity"
            android:exported="false"
            android:label="@string/view_stickers"
            android:parentActivityName=".CollectionActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".CollectionActivity" />
        </activity>

        <activity
            android:name=".FetchActivity"
            android:exported="true"
            android:label="@string/title_activity_fetch">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Deep Linking for LINE Stickers and Emojis -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="line.me" android:pathPrefix="/S/sticker/" />
                <data android:scheme="https" android:host="line.me" android:pathPrefix="/S/emoji/" />
                <data android:scheme="https" android:host="store.line.me" android:pathPrefix="/stickershop/product/" />
                <data android:scheme="https" android:host="store.line.me" android:pathPrefix="/emojishop/product/" />
            </intent-filter>
        </activity>

        <!-- Input Method Service -->
        <service
            android:name=".IMService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <service
            android:name=".FetchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".EmojiFetchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.lseboard.app"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>

